			min-zoom : 16
			shape : square
			shape-size : 13:3.5;16:4.5;19:6
			fill-color : #d0568a
			line-style : none
		draw : shape
		define
			min-zoom : 16
			text : name
			font-size : 13:6;16:7;19:8
			font-weight : normal
			text-color : #d1568a
			text-offset-vertical : 130%
			text-halo-width : 0
		draw : text

	// --- Shops - other specialised retail (square, grey) ---
	target : $regex("^poi shop (books|gift|toys|sports|music|department store|laundry|travel agency|copyshop|pet|tobacco|wholesale|generic)$")
		define
			min-zoom : 17
