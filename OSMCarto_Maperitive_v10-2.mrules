// #####################################################################
// #   MAPERITIVE STYLESHEET - INSPIRED BY THE OPENSTREETMAP CARTO STYLE #
// #####################################################################
//
// A comprehensive rendering style for Maperitive (maperitive.net), built
// for exporting compact, richly-detailed SVG artwork that serves as a
// graphic base layer for further design work (e.g. in Adobe Illustrator).
//
// DESIGN PRINCIPLES
//   - Every colour (fill/line/text) is unique across the whole file, so
//     "Select Same > Fill/Stroke Color" in Illustrator never pulls in
//     unrelated categories. Where two categories would otherwise share a
//     colour, one is nudged by a visually imperceptible amount (a few RGB
//     units at most).
//   - No text halos anywhere: Maperitive draws its own default halo behind
//     any text that does not explicitly set text-halo-width, so every
//     single text/shield rule sets text-halo-width to 0 to suppress it -
//     both for a cleaner look and to avoid extra duplicate label objects
//     in the SVG export.
//   - No opacity/transparency settings anywhere: every fill and stroke is
//     fully opaque.
//   - Roads, streets and paths are drawn as a SINGLE stroke object per
//     class (no separate casing/outline layer), to keep the exported file
//     small. The one deliberate exception is bridges, which get a second,
//     wider, distinctly-coloured stroke drawn underneath to signal the
//     elevated structure. Tunnels and indoor passages (e.g. roads through
//     a building or parking garage) are shown with a distinct line style
//     instead of a border, so outdoor/tunnel/indoor are always visually
//     distinct without adding extra objects.
//   - Likewise, area fills (buildings, landuse, natural land cover...) are
//     drawn without a separate outline stroke - Maperitive always renders
//     a bordered polygon as two separate draw calls (fill + stroke), so
//     skipping the border halves the object count for the most common
//     feature classes in any city.
//   - Line-attached text (road names, river names, route names, contour
//     elevation figures) always uses text-orientation: flow, meaning the
//     whole label rotates to match the local line direction as a single
//     rigid block - it is never bent glyph-by-glyph along a curve.
//   - Waymarked routes (hiking, cycling, MTB, horse riding, ski, long-
//     distance, public transport) are rendered as a distinctly-coloured,
//     offset overlay on top of the road/path network (offset sideways
//     with line-offset, in the spirit of waymarkedtrails.org and
//     mtbmap.cz), so the underlying street keeps its own normal styling
//     while the route stays continuously visible and easy to isolate as
//     its own layer, regardless of which road types it happens to follow.
//   - Label collision suppression is switched off (both
//     map.rendering.detect-label-collision and text-avoid-overlaps),
//     since the goal is maximum text content in the SVG export; visual
//     curation is expected to happen afterwards in Illustrator layers.
//
// POINTS OF INTEREST
//   Maperitive can only place bitmap (.png) icons from disk, not SVG
//   pictograms, and this file ships with no image assets. POI categories
//   are therefore distinguished by marker shape and colour instead of a
//   picture: circle/square/triangle/diamond, each in its own colour
//   family, with every marker a small uniform size and a name label from
//   the same zoom level as the marker itself. To switch a category over to
//   a real bitmap icon later, add "icon-image : path/to/icon.png" and
//   "draw : icon" to that rule.
//
// SCOPE NOTES AND KNOWN LIMITATIONS
//   - Waterway line width is driven by the waterway TYPE hierarchy
//     (river > canal > stream > drain > ditch), not by the numeric
//     width=* tag: Maperitive's query grammar has no confirmed numeric
//     comparison operators, only equality/set-membership tests, so an
//     arbitrary tag value cannot be read and used directly as a line
//     width.
//   - Relations are used for waymarked routes and administrative
//     boundaries via relation[...].way[] (a well-confirmed pattern).
//     Area-type multipolygon relations (relation[type=multipolygon AND
//     (...)]) are also defined alongside plain closed-way features for
//     the most common landuse/natural categories, on a best-effort basis -
//     Maperitive's own author has stated he cannot recall a working
//     example of a relation used for an area feature, so this is included
//     for coverage but its reliability is unconfirmed. Boundary-type
//     relations therefore always additionally render as a plain line, to
//     guarantee they show up even if the area assembly does not.
//   - Sea-depth (bathymetric) contours are defined and styled, but will
//     only produce anything if the loaded elevation raster actually
//     contains negative (below sea level) values.
//   - SVG layer/group naming and metadata are controlled by Maperitive's
//     export mechanism itself, not by anything expressible in a .mrules
//     rules file, so this file has no influence over that.
//

features
	points
		// --- Settlements and place labels (place=*) ---
		place country : place=country
		place state : place=state
		place capital city : place=city AND capital=yes
		place city : place=city AND NOT capital=yes
		place town : place=town
		place suburb : place=suburb
		place quarter : place=quarter OR place=neighbourhood
		place village : place=village
		place hamlet : place=hamlet
		place isolated dwelling : place=isolated_dwelling
		place locality : place=locality
		place island : place=island OR place=islet
		place square : place=square
		// --- Transport ---
		poi transport busstop : highway=bus_stop
		poi transport busstation : amenity=bus_station
		poi transport station : railway=station OR railway=halt
		poi transport tram stop : railway=tram_stop
		poi transport subway entrance : railway=subway_entrance
		poi transport aerodrome : aeroway=aerodrome
		poi transport helipad : aeroway=helipad
		poi transport gate : aeroway=gate
		poi transport ferry terminal : amenity=ferry_terminal
		poi transport taxi : amenity=taxi
		poi transport fuel : amenity=fuel
		poi transport charging station : amenity=charging_station
		poi transport car wash : amenity=car_wash
		poi transport car rental : amenity=car_rental
		poi transport car repair : shop=car_repair OR shop=tyres
		poi transport car shop : shop=car OR shop=car_parts OR shop=motorcycle
		poi transport parking : amenity=parking AND NOT (parking=multi-storey OR parking=underground)
		poi transport parking multi : parking=multi-storey OR parking=underground
		poi transport parking entrance : amenity=parking_entrance
		poi transport motorcycle parking : amenity=motorcycle_parking
		poi transport bicycle parking : amenity=bicycle_parking
		poi transport bicycle rental : amenity=bicycle_rental
		poi transport bicycle repair : amenity=bicycle_repair_station
		poi transport traffic signals : highway=traffic_signals
		poi transport motorway junction : highway=motorway_junction
		poi transport ford : highway=ford OR ford=yes
		poi transport elevator : highway=elevator
		poi transport toll booth : barrier=toll_booth
		// --- Food and drink ---
		poi food restaurant : amenity=restaurant
		poi food cafe : amenity=cafe
		poi food bar : amenity=bar
		poi food pub : amenity=pub
		poi food biergarten : amenity=biergarten
		poi food fast food : amenity=fast_food
		poi food court : amenity=food_court
		poi food ice cream : amenity=ice_cream OR cuisine=ice_cream
		// --- Education ---
		poi edu school : amenity=school
		poi edu university : amenity=university
		poi edu college : amenity=college
		poi edu kindergarten : amenity=kindergarten OR amenity=childcare
		poi edu library : amenity=library
		poi edu driving school : amenity=driving_school
		// --- Healthcare and social care ---
		poi health hospital : amenity=hospital
		poi health clinic : amenity=clinic
		poi health doctors : amenity=doctors
		poi health dentist : amenity=dentist
		poi health pharmacy : amenity=pharmacy
		poi health veterinary : amenity=veterinary
		poi health social facility : amenity=social_facility OR amenity=nursing_home
		// --- Finance ---
		poi finance bank : amenity=bank
		poi finance atm : amenity=atm
		poi finance bureau de change : amenity=bureau_de_change
		// --- Civic administration, safety, diplomacy ---
		poi civic townhall : amenity=townhall
		poi civic courthouse : amenity=courthouse
		poi civic police : amenity=police
		poi civic fire station : amenity=fire_station
		poi civic post office : amenity=post_office
		poi civic post box : amenity=post_box
		poi civic prison : amenity=prison
		poi civic embassy : office=diplomatic OR diplomatic=embassy
		poi civic consulate : diplomatic=consulate
		poi civic community centre : amenity=community_centre OR amenity=social_centre
		// --- Culture and entertainment ---
		poi culture theatre : amenity=theatre
		poi culture cinema : amenity=cinema
		poi culture arts centre : amenity=arts_centre
		poi culture museum : tourism=museum
		poi culture gallery : tourism=gallery
		poi culture nightclub : amenity=nightclub
		poi culture casino : amenity=casino
		// --- Religion ---
		poi religion christian : amenity=place_of_worship AND religion=christian
		poi religion muslim : amenity=place_of_worship AND religion=muslim
		poi religion jewish : amenity=place_of_worship AND religion=jewish
		poi religion buddhist : amenity=place_of_worship AND religion=buddhist
		poi religion hindu : amenity=place_of_worship AND religion=hindu
		poi religion other : amenity=place_of_worship AND NOT @isOneOf(religion,christian,muslim,jewish,buddhist,hindu)
		poi religion wayside cross : historic=wayside_cross OR man_made=cross
		poi religion wayside shrine : historic=wayside_shrine
		// --- Tourist accommodation ---
		poi stay hotel : tourism=hotel
		poi stay hostel : tourism=hostel
		poi stay guest house : tourism=guest_house
		poi stay motel : tourism=motel
		poi stay apartment : tourism=apartment
		poi stay chalet : tourism=chalet
		poi stay alpine hut : tourism=alpine_hut OR tourism=wilderness_hut
		poi stay camp site : tourism=camp_site
		poi stay caravan site : tourism=caravan_site
		poi stay picnic site : tourism=picnic_site
		// --- Tourist attractions ---
		poi tourism viewpoint : tourism=viewpoint
		poi tourism attraction : tourism=attraction
		poi tourism artwork : tourism=artwork
		poi tourism zoo : tourism=zoo
		poi tourism theme park : tourism=theme_park
		poi tourism information : tourism=information
		// --- Historic sites ---
		poi historic castle : historic=castle
		poi historic fort : historic=fort
		poi historic ruins : historic=archaeological_site OR historic=ruins
		poi historic monument : historic=monument
		poi historic memorial : historic=memorial
		poi historic city gate : historic=city_gate
		poi historic manor : historic=manor
		// --- Sport and leisure (points) ---
		poi leisure playground : leisure=playground
		poi leisure sports centre : leisure=sports_centre OR leisure=fitness_centre
		poi leisure fitness station : leisure=fitness_station
		poi leisure golf course : leisure=golf_course
		poi leisure marina : leisure=marina
		poi leisure slipway : leisure=slipway
		poi leisure water park : leisure=water_park
		poi leisure swimming pool : leisure=swimming_pool
		poi leisure ice rink : leisure=ice_rink
		poi leisure bowling alley : leisure=bowling_alley OR leisure=amusement_arcade
		poi leisure dog park : leisure=dog_park
		// --- Shops - food ---
		poi shop supermarket : shop=supermarket
		poi shop convenience : shop=convenience OR shop=kiosk
		poi shop bakery : shop=bakery OR shop=pastry
		poi shop butcher : shop=butcher OR shop=seafood
		poi shop greengrocer : shop=greengrocer OR shop=farm
		poi shop deli : shop=deli OR shop=dairy
		poi shop alcohol : shop=alcohol OR shop=wine OR shop=beverages
		poi shop confectionery : shop=confectionery OR shop=chocolate OR shop=tea OR shop=coffee
		// --- Shops - fashion and accessories ---
		poi shop clothes : shop=clothes OR shop=fashion
		poi shop shoes : shop=shoes
		poi shop jewelry : shop=jewelry OR shop=bag OR shop=watches
		poi shop second hand : shop=second_hand OR shop=charity OR shop=variety_store
		// --- Shops - home, garden, household ---
		poi shop furniture : shop=furniture OR shop=houseware OR shop=interior_decoration OR shop=carpet
		poi shop hardware : shop=hardware OR shop=doityourself OR shop=paint OR shop=trade
		poi shop garden centre : shop=garden_centre OR shop=florist
		poi shop electronics : shop=electronics OR shop=computer OR shop=hifi OR shop=mobile_phone
		// --- Shops - health and beauty ---
		poi shop hairdresser : shop=hairdresser OR shop=beauty OR shop=massage
		poi shop optician : shop=optician OR shop=hearing_aids OR shop=medical_supply
		poi shop chemist : shop=chemist OR shop=cosmetics
		// --- Shops - other specialised retail ---
		poi shop books : shop=books OR shop=newsagent OR shop=stationery
		poi shop gift : shop=gift OR shop=art OR shop=photo OR shop=photo_studio
		poi shop toys : shop=toys OR shop=games OR shop=video_games
		poi shop sports : shop=sports OR shop=outdoor OR shop=bicycle
		poi shop music : shop=music OR shop=musical_instrument OR shop=video
		poi shop department store : shop=department_store OR shop=mall
		poi shop laundry : shop=laundry OR shop=dry_cleaning
		poi shop travel agency : shop=travel_agency OR shop=ticket
		poi shop copyshop : shop=copyshop
		poi shop pet : shop=pet
		poi shop tobacco : shop=tobacco OR shop=bookmaker
		poi shop wholesale : shop=wholesale
		poi shop generic : shop AND NOT @isOneOf(shop,supermarket,convenience,kiosk,bakery,pastry,butcher,seafood,greengrocer,farm,deli,dairy,alcohol,wine,beverages,confectionery,chocolate,tea,coffee,clothes,fashion,shoes,jewelry,bag,watches,second_hand,charity,variety_store,furniture,houseware,interior_decoration,carpet,hardware,doityourself,paint,trade,garden_centre,florist,electronics,computer,hifi,mobile_phone,hairdresser,beauty,massage,optician,hearing_aids,medical_supply,chemist,cosmetics,books,newsagent,stationery,gift,art,photo,photo_studio,toys,games,video_games,sports,outdoor,bicycle,music,musical_instrument,video,department_store,mall,laundry,dry_cleaning,travel_agency,ticket,copyshop,pet,tobacco,bookmaker,wholesale,car_repair,tyres,car,car_parts,motorcycle)
		// --- Natural point features ---
		poi natural peak : natural=peak
		poi natural saddle : natural=saddle OR mountain_pass=yes
		poi natural volcano : natural=volcano
		poi natural cave : natural=cave_entrance
		poi natural spring : natural=spring
		poi natural tree : natural=tree
		poi natural cape : natural=cape OR natural=peninsula
		poi natural waterfall : waterway=waterfall
		// --- Barriers (points) ---
		poi barrier gate : barrier=gate
		poi barrier lift gate : barrier=lift_gate OR barrier=swing_gate
		poi barrier bollard : barrier=bollard OR barrier=block
		poi barrier cycle barrier : barrier=cycle_barrier OR barrier=motorcycle_barrier
		poi barrier stile : barrier=stile OR barrier=kissing_gate OR barrier=turnstile
		poi barrier cattle grid : barrier=cattle_grid
		// --- Technical and industrial structures (points) ---
		poi manmade tower : man_made=tower OR man_made=communications_tower OR man_made=mast
		poi manmade watertower : man_made=water_tower OR man_made=water_works
		poi manmade silo : man_made=silo OR man_made=storage_tank
		poi manmade chimney : man_made=chimney
		poi manmade lighthouse : man_made=lighthouse
		poi manmade windmill : man_made=windmill
		poi manmade crane : man_made=crane
		poi manmade obelisk : man_made=obelisk
		poi manmade works : man_made=works OR man_made=wastewater_plant
		// --- Power infrastructure ---
		poi power tower : power=tower
		poi power pole : power=pole
		poi power generator : power=generator
		poi power substation : power=substation OR power=plant
		// --- Military ---
		poi military bunker : military=bunker
		// --- Small public amenities ---
		poi amenity drinking water : amenity=drinking_water
		poi amenity toilets : amenity=toilets
		poi amenity bench : amenity=bench
		poi amenity waste basket : amenity=waste_basket OR amenity=waste_disposal
		poi amenity recycling : amenity=recycling
		poi amenity vending machine : amenity=vending_machine OR amenity=parcel_locker
		poi amenity shelter : amenity=shelter
		poi amenity fountain : amenity=fountain
		poi amenity telephone : amenity=telephone OR emergency=phone
		poi amenity marketplace : amenity=marketplace
		poi amenity public bookcase : amenity=public_bookcase
		// -----------------------------------------------------------------
		//  ADDITIONAL POI RECORDED IN OSM BUT NOT RENDERED BY STANDARD
		//  OPENSTREETMAP CARTO (added on request - genuinely useful tags that
		//  the official carto style leaves out)
		// -----------------------------------------------------------------
		poi extra office : office AND NOT office=diplomatic
		poi extra craft : craft
		poi extra healthcare : healthcare AND NOT @isOneOf(healthcare,hospital,clinic,doctor,dentist,pharmacy,centre)
		poi extra aquarium : tourism=aquarium
		poi extra coworking : amenity=coworking_space OR amenity=studio
		poi extra animal : amenity=animal_shelter OR amenity=animal_boarding
		poi extra boat rental : amenity=boat_rental OR amenity=canoe_hire
		poi extra car sharing : amenity=car_sharing
		poi extra surveillance : man_made=surveillance
		poi extra antenna : man_made=antenna
		poi extra monastery : historic=monastery OR amenity=monastery
		poi extra grave : amenity=grave
		poi extra fishing : leisure=fishing
		poi extra reef : natural=reef OR natural=shoal
		poi extra stolperstein : memorial=stolperstein OR memorial:type=stolperstein
		poi extra memorial tree : natural=tree AND (memorial=yes OR historic=yes OR monument=yes)
		poi extra wikipedia : wikipedia AND NOT @isOneOf(historic,castle,fort,archaeological_site,ruins,monument,memorial,city_gate,manor) AND NOT tourism AND NOT amenity AND NOT shop
		// -----------------------------------------------------------------
		//  NOTABLE BUT LESS COMMON FEATURES (decorative/scene-setting purpose)
		// -----------------------------------------------------------------
		poi special arch : natural=arch
		poi special sinkhole : natural=sinkhole
		poi special geyser : natural=geyser
		poi special hot spring : natural=hot_spring
		poi special rock : natural=rock OR natural=stone
		poi special flagpole : man_made=flagpole
		poi special telescope : man_made=telescope OR man_made=observatory
		poi special watermill : man_made=watermill
		poi special ship : historic=ship
		poi special aircraft : historic=aircraft OR historic=tank
		poi special bandstand : leisure=bandstand
		poi special clock : amenity=clock
		poi special sundial : man_made=sundial
		poi special milestone : historic=milestone OR man_made=milestone
		poi special boundary stone : historic=boundary_stone
		poi special beehive : man_made=beehive OR craft=beekeeper
		poi special water well : man_made=water_well
		poi special fire hydrant : emergency=fire_hydrant

	lines

		hw motorway : highway=motorway OR (highway=construction AND construction=motorway)
		hw motorway link : highway=motorway_link OR (highway=construction AND construction=motorway_link)
		hw trunk : highway=trunk OR (highway=construction AND construction=trunk)
		hw trunk link : highway=trunk_link OR (highway=construction AND construction=trunk_link)
		hw primary : highway=primary OR (highway=construction AND construction=primary)
		hw primary link : highway=primary_link OR (highway=construction AND construction=primary_link)
		hw secondary : highway=secondary OR (highway=construction AND construction=secondary)
		hw secondary link : highway=secondary_link OR (highway=construction AND construction=secondary_link)
		hw tertiary : highway=tertiary OR (highway=construction AND construction=tertiary)
		hw tertiary link : highway=tertiary_link OR (highway=construction AND construction=tertiary_link)
		hw unclassified : highway=unclassified OR (highway=construction AND construction=unclassified)
		hw residential : highway=residential OR (highway=construction AND construction=residential)
		hw living street : highway=living_street OR (highway=construction AND construction=living_street)
		hw pedestrian way : highway=pedestrian AND NOT area=yes
		hw service : highway=service OR (highway=construction AND construction=service)
		hw road unknown : highway=road
		hw construction generic : highway=construction AND NOT construction
		hw track : highway=track
		hw footway : highway=footway AND NOT (bicycle=designated AND foot=no)
		hw steps : highway=steps
		hw cycleway : highway=cycleway
		hw bridleway : highway=bridleway
		hw path : highway=path
		hw raceway : highway=raceway OR highway=motor
		hw bus guideway : highway=bus_guideway
		tr aeroway taxiway line : aeroway=taxiway

		golf hole line : golf=hole
		golf cartpath : golf=cartpath
		hw mini roundabout centre : highway=mini_roundabout
		hw ski nordic : piste:type=nordic

		hw access private : access=private AND highway
		hw access destination : access=destination AND highway

		rail main : railway=rail AND NOT service AND NOT usage=branch
		rail branch : railway=rail AND usage=branch AND NOT service
		rail main service : railway=rail AND service
		rail narrow gauge : railway=narrow_gauge
		rail light rail : railway=light_rail
		rail subway : railway=subway
		rail tram : railway=tram
		rail funicular : railway=funicular OR railway=monorail
		rail miniature : railway=miniature
		rail disused : railway=disused OR railway=abandoned OR railway=razed
		rail platform edge : railway=platform OR public_transport=platform

		water river : waterway=river
		water canal : waterway=canal
		water stream : waterway=stream
		water drain : waterway=drain
		water ditch : waterway=ditch
		water weir : waterway=weir OR waterway=dam
		water lock gate : waterway=lock_gate

		aerial closed cabin : @isOneOf(aerialway,cable_car,gondola,mixed_lift)
		aerial open : @isOneOf(aerialway,chair_lift,drag_lift,t-bar,j-bar,platter,rope_tow)
		aerial goods : aerialway=goods OR aerialway=zip_line

		power line major : power=line
		power line minor : power=minor_line

		barrier wall : barrier=wall
		barrier retaining wall : barrier=retaining_wall
		barrier citywall : historic=citywalls OR historic=city_wall
		barrier fence : barrier=fence OR barrier=hedge

		ferry route : route=ferry

		route hiking intl : relation[type=route AND route=hiking AND network=iwn].way[]
		route hiking national : relation[type=route AND route=foot AND network=nwn].way[]
		route hiking regional : relation[type=route AND route=foot AND @isOneOf(network,rwn,lwn)].way[]
		route cycling intl : relation[type=route AND route=bicycle AND network=icn].way[]
		route cycling national : relation[type=route AND route=bicycle AND network=ncn].way[]
		route cycling regional : relation[type=route AND route=bicycle AND @isOneOf(network,rcn,lcn)].way[]

		route mtb : relation[type=route AND route=mtb].way[]
		route horse : relation[type=route AND route=horse].way[]
		route ski : relation[type=route AND route=ski].way[]
		route eway : relation[type=route AND network=iwn AND ref].way[]

		route bus : relation[type=route AND @isOneOf(route,bus,trolleybus)].way[]
		route train : relation[type=route AND @isOneOf(route,train,tram)].way[]


		route czeuro : relation[type=route AND (route=hiking OR route=foot) AND network=lwn AND NOT type=stop].way[]
		route green : relation[type=route AND kct_green=major].way[]
		route blue : relation[type=route AND kct_blue=major].way[]
		route yellow : relation[type=route AND kct_yellow=major].way[]
		route red : relation[type=route AND kct_red=major].way[]
		route : relation[type=route AND route=hiking].way[]
		route bike : relation[type=route AND route=bicycle].way[]

		admin state rel : relation[type=boundary AND boundary=administrative AND admin_level=2].way[]
		admin region rel : relation[type=boundary AND boundary=administrative AND admin_level=4].way[]
		admin district rel : relation[type=boundary AND boundary=administrative AND admin_level=6].way[]
		admin orp rel : relation[type=boundary AND boundary=administrative AND admin_level=7].way[]
		admin municipality rel : relation[type=boundary AND boundary=administrative AND admin_level=8].way[]
		admin part rel : relation[type=boundary AND boundary=administrative AND (admin_level=9 OR admin_level=10)].way[]

		national park line rel : relation[type=boundary AND boundary=national_park].way[]
		protected area line rel : relation[type=boundary AND boundary=protected_area].way[]

		coastline : natural=coastline
		cliff : natural=cliff

		contour major 50m : contour[elevation_multiplier=50]
		contour minor 10m : contour[elevation_multiplier=10]

		contour sea major 50m : contour[elevation_multiplier=-50]
		contour sea minor 10m : contour[elevation_multiplier=-10]

	areas

		// --- Chránìná území (plochy pro umístìní názvu) ---
		np area : relation[type=boundary AND boundary=national_park]
		pa area : relation[type=boundary AND boundary=protected_area]

		// --- Natural vegetation and terrain cover (paired with relations) ---
		nat forest : landuse=forest OR natural=wood
		nat forest mp : relation[type=multipolygon AND (landuse=forest OR natural=wood)]
		nat scrub : natural=scrub OR natural=shrubbery
		nat heath : natural=heath
		nat grassland : natural=grassland OR natural=fell
		nat wetland : natural=wetland OR natural=marsh
		nat bare rock : natural=bare_rock OR natural=scree OR natural=shingle
		nat sand : natural=sand
		nat mud : natural=mud
		nat beach : natural=beach
		nat glacier : natural=glacier
		nat water : (natural=water OR waterway=riverbank OR landuse=reservoir OR landuse=basin OR waterway=dock) AND NOT intermittent=yes AND NOT water=intermittent AND NOT seasonal=yes
		nat water mp : relation[type=multipolygon AND ((natural=water OR waterway=riverbank OR landuse=reservoir OR landuse=basin OR waterway=dock) AND NOT intermittent=yes AND NOT water=intermittent AND NOT seasonal=yes)]
		nat water intermittent : (natural=water OR landuse=reservoir OR landuse=basin) AND (intermittent=yes OR water=intermittent OR seasonal=yes)
		nat water intermittent mp : relation[type=multipolygon AND ((natural=water OR landuse=reservoir OR landuse=basin) AND (intermittent=yes OR water=intermittent OR seasonal=yes))]
		// --- Agriculture ---
		agr farmland : landuse=farmland
		agr farmland mp : relation[type=multipolygon AND (landuse=farmland)]
		agr farmyard : landuse=farmyard
		agr orchard : landuse=orchard OR landuse=vineyard OR landuse=plant_nursery
		agr meadow : landuse=meadow OR natural=meadow
		agr meadow mp : relation[type=multipolygon AND (landuse=meadow OR natural=meadow)]
		agr allotments : landuse=allotments
		agr greenhouse : landuse=greenhouse_horticulture
		// --- Built-up land (functional zones, paired with relations) ---
		lu residential : landuse=residential
		lu residential mp : relation[type=multipolygon AND (landuse=residential)]
		lu retail : landuse=retail
		lu retail mp : relation[type=multipolygon AND (landuse=retail)]
		lu commercial : landuse=commercial
		lu commercial mp : relation[type=multipolygon AND (landuse=commercial)]
		lu industrial : landuse=industrial OR landuse=railway OR man_made=works OR man_made=wastewater_plant OR man_made=water_works
		lu industrial mp : relation[type=multipolygon AND (landuse=industrial OR landuse=railway OR man_made=works OR man_made=wastewater_plant OR man_made=water_works)]
		lu garages : landuse=garages
		lu construction : landuse=construction OR landuse=brownfield
		lu landfill : landuse=landfill
		lu religious : landuse=religious OR amenity=place_of_worship
		lu village green : landuse=village_green OR landuse=grass
		lu recreation ground : landuse=recreation_ground
		lu salt pond : landuse=salt_pond
		// --- Cemeteries, military and quarry areas ---
		sp cemetery : landuse=cemetery OR amenity=grave_yard
		sp cemetery mp : relation[type=multipolygon AND (landuse=cemetery OR amenity=grave_yard)]
		sp military : landuse=military OR military=barracks OR military=danger_area
		sp quarry : landuse=quarry
		// --- Parks, gardens and protected areas ---
		lz park : leisure=park
		lz garden : leisure=garden
		lz nature reserve : leisure=nature_reserve
		lz nature reserve mp : relation[type=multipolygon AND (leisure=nature_reserve)]
		// --- Sport and recreation (areas) ---
		lz pitch : leisure=pitch
		lz track : leisure=track
		lz stadium : leisure=stadium OR leisure=sports_centre
		lz golf course area : leisure=golf_course OR golf=fairway
		lz golf green : golf=green
		lz golf bunker : golf=bunker OR golf=sand
		lz golf driving range : golf=driving_range
		lz golf rough : golf=rough
		lz playground area : leisure=playground
		lz swimming pool area : leisure=swimming_pool
		lz water park area : leisure=water_park
		lz dog park area : leisure=dog_park
		lz marina area : leisure=marina
		lz camp site area : tourism=camp_site OR tourism=caravan_site OR tourism=picnic_site
		lz beach resort : leisure=beach_resort
		// --- Transport - parking and airports (areas) ---
		tr parking area : amenity=parking
		tr aeroway apron : aeroway=apron
		tr aeroway terminal : aeroway=terminal
		tr aeroway runway area : aeroway=runway
		tr aerodrome area : aeroway=aerodrome
		tr heliport area : aeroway=heliport
		rail platform area : railway=platform OR public_transport=platform
		tr pedestrian area : highway=pedestrian AND area=yes
		tr footway area : highway=footway AND area=yes
		// --- Winter sports areas ---
		winter piste downhill novice : piste:type=downhill AND piste:difficulty=novice
		winter piste downhill easy : piste:type=downhill AND piste:difficulty=easy
		winter piste downhill intermediate : piste:type=downhill AND piste:difficulty=intermediate
		winter piste downhill advanced : piste:type=downhill AND piste:difficulty=advanced
		winter piste downhill expert : piste:type=downhill AND piste:difficulty=expert
		winter piste downhill other : piste:type=downhill AND NOT @isOneOf(piste:difficulty,novice,easy,intermediate,advanced,expert)
		winter sports area : landuse=winter_sports
		// --- Buildings ---
		bld major : @isOneOf(building,church,cathedral,chapel,hospital,school,university,college,public,civic,government,train_station,castle,hotel,mosque,synagogue,temple,stadium)
		bld regular : building AND NOT @isOneOf(building,church,cathedral,chapel,hospital,school,university,college,public,civic,government,train_station,castle,hotel,mosque,synagogue,temple,stadium,no,none)
		man made bridge area : man_made=bridge

properties
	// Basic map appearance (land/sea colour per OSM Carto)
	map-background-color : #f2efe9
	map-background-opacity : 1
	map-sea-color : #aad3df

	// Default font (Noto Sans is the OSM Carto font; if it
	//   is not installed on the system, substitute e.g. Arial/DejaVu Sans)
	font-family : Noto Sans
	font-weight : normal
	font-stretch : 0.92
	text : name
	text-color : #222222
	text-align-horizontal : center
	text-align-vertical : center
	text-max-width : 8
	// Text on lines rotates to match the line's direction as a single rigid
	// block (text-orientation: flow) - it never bends glyph-by-glyph along
	// a curve.
	text-orientation : flow

	// Label placement tuned to the most permissive settings possible, so
	// that as many street name labels as possible get displayed, even on
	// short or curved segments.

	// Maperitive DOES have a label-vs-label collision system (added in 2.3.x):
	// when two labels overlap, the lower-priority one - priority being the
	// order features/rules appear in this file, earlier = higher priority -
	// is silently dropped from the render. Since the goal here is maximum
	// text content in the SVG export (curation happens afterwards in
	// Illustrator layers), that whole system is switched off globally, both
	// the newer per-text-command flag and the older global engine setting.
	text-avoid-overlaps : false
	map.rendering.detect-label-collision : false
	map.rendering.lflp.min-buffer-space : 0
	map.rendering.lflp.max-allowed-corner-angle : 0
	map.rendering.lflp.max-compression : 0.5

rules

	// ==================================================================
	// 1. AREA FEATURES (POLYGONS) - NATURE, AGRICULTURE, BUILT-UP LAND
	// ==================================================================
	// --- Forests, natural vegetation and bare terrain types ---
	target : $regex("^(nat forest|nat forest mp)$")
		define
			fill-color : #add19e
			line-style : none
		draw : fill
		define
			text : name
			text-color : #46673b
			font-size : 11:8;16:13
			text-orientation : flow
			min-zoom : 11
			text-halo-width : 0
		draw : text

	target : nat scrub
		define
			fill-color : #c8d7ab
			line-style : none
		draw : fill

	target : nat heath
		define
			fill-color : #d6d99f
			line-style : none
		draw : fill

	target : nat grassland
		define
			fill-color : #cdebb0
			line-style : none
		draw : fill

	target : $regex("^(agr meadow|agr meadow mp)$")
		define
			fill-color : #d5e8b0
			line-style : none
		draw : fill

	target : $regex("^(agr farmland|agr farmland mp)$")
		define
			fill-color : #eef0d5
			line-style : none
		draw : fill

	target : agr orchard
		define
			fill-color : #aedfa3
			line-style : none
		draw : fill

	target : agr allotments
		define
			fill-color : #c9e1bf
			line-style : none
		draw : fill

	target : agr greenhouse
		define
			fill-color : #e3e3e3
			line-style : none
		draw : fill

	target : agr farmyard
		define
			fill-color : #f5dcba
			line-style : none
		draw : fill

	target : nat wetland
		define
			fill-color : #d3e8d3
			line-style : none
		draw : fill

	target : nat bare rock
		define
			fill-color : #c5c3c3
			line-style : none
		draw : fill

	target : nat sand
		define
			fill-color : #f5e9c6
			line-style : none
		draw : fill

	target : nat mud
		define
			fill-color : #e6dcd1
			line-style : none
		draw : fill

	target : nat beach
		define
			min-zoom : 10
			fill-color : #fff1ba
			line-style : none
		draw : fill

	// --- Quarries, military and redevelopment areas (no hatch pattern) ---
	target : sp quarry
		define
			fill-color : #e3e2e2
			line-style : none
		draw : fill

	target : sp military
		define
			fill-color : #f55555
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text


	target : lu construction
		define
			fill-color : #c7c7b4
			line-style : none
		draw : fill

	target : lu landfill
		define
			fill-color : #b7b09c
			line-style : none
		draw : fill

	// --- Built-up land (functional zones) ---
	target : lu garages
		define
			fill-color : #dfddce
			line-style : none
		draw : fill

	target : $regex("^(lu industrial|lu industrial mp)$")
		define
			fill-color : #ebdbe8
			line-style : none
		draw : fill

	target : $regex("^(lu commercial|lu commercial mp)$")
		define
			fill-color : #f2dad9
			line-style : none
		draw : fill

	target : $regex("^(lu retail|lu retail mp)$")
		define
			fill-color : #ffd6d1
			line-style : none
		draw : fill

	target : $regex("^(lu residential|lu residential mp)$")
		define
			fill-color : #e0dfdf
			line-style : none
		draw : fill

	target : lu village green
		define
			fill-color : #ceebb0
			line-style : none
		draw : fill

	target : lu recreation ground
		define
			fill-color : #efc8c8
			line-style : none
		draw : fill

	target : lu salt pond
		define
			fill-color : #e7f6f6
			line-style : none
		draw : fill

	target : lu religious
		define
			fill-color : #d0d0d0
			line-style : none
		draw : fill

	target : $regex("^(sp cemetery|sp cemetery mp)$")
		define
			fill-color : #aacbaf
			line-style : none
		draw : fill

	// --- Nature reserve (leisure=nature_reserve is a genuine area tag, unlike
	//   the boundary=* relations below, which are rendered as lines only) ---
	target : lz nature reserve
		define
			fill-color : #c8e8c0
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text


	// --- Parks, gardens and recreational-purpose areas ---
	target : lz park
		define
			fill-color : #c8facc
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text

	target : lz garden
		define
			fill-color : #cdecb0
			line-style : none
		draw : fill

	target : lz pitch
		define
			fill-color : #88e0be
			line-style : none
		draw : fill

	target : lz track
		define
			fill-color : #89e0be
			line-style : none
		draw : fill

	target : lz stadium
		define
			fill-color : #33cc99
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text


	target : lz golf course area
		define
			fill-color : #b5e0a3
			line-style : none
		draw : fill

	target : lz golf green
		define
			min-zoom : 15
