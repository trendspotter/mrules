		define
			min-zoom : 13
			shape : custom
			shape-def : p:#556b2f;pw:2;m:-7,0;l:7,0;m:0,-5;l:0,5
			shape-size : 13:3.5;16:4.5;19:6
			fill-color : #556b2f
			line-style : none
		draw : shape
		define
			min-zoom : 13
			text : name
			font-size : 13:6;16:7;19:8
			font-weight : normal
			text-color : #566b2f
			text-offset-vertical : 130%
			text-halo-width : 0
		draw : text

	target : $regex("^poi special (bandstand)$")
