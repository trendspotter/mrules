		draw : fill

	target : lz swimming pool area
		define
			fill-color : #abd3df
			line-style : none
		draw : fill

	target : lz water park area
		define
			fill-color : #aad4df
			line-style : none
		draw : fill

	target : lz dog park area
		define
			fill-color : #c9facc
			line-style : none
		draw : fill

	target : lz marina area
		define
			fill-color : #aad3e0
			line-style : none
		draw : fill

	target : lz camp site area
		define
			fill-color : #def6c0
			line-style : none
		draw : fill
		define
			text : name
			text-color : #def6c0
			font-size : 10:8;16:13
