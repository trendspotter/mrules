			text-halo-width : 0
		draw : text

	// --- Natural point features (triangle, dark green) ---
	// Peaks: name AND elevation in metres, e.g. 'Plechy (1378 m)'.
	target : $regex("^poi natural (peak)$")
		define
			min-zoom : 11
			shape : custom
			shape-def : f:#4c7024;p:#3a5c1a;pw:1;0,-6,6,6,-6,6;Z
			shape-size : 13:3.5;16:4.5;19:6
			fill-color : #4c7124
			line-style : none
		draw : shape
		define
			min-zoom : 12
			text : @if(name, name @if(ele, " " ele " m"), @if(ele, ele " m"))
			font-size : 13:6;16:7;19:8
			font-weight : normal
			text-color : #3a5c1a
			text-offset-vertical : 130%
			text-halo-width : 0
		draw : text
