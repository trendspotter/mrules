		draw : text


	target : winter piste downhill expert
		define
			min-zoom : 11
			fill-color : #1a1a1b
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;16:13
			text-orientation : flow
