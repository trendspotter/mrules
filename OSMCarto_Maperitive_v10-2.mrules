	// ==================================================================
	// 13. POINTS OF INTEREST (POI)
	// ==================================================================
	// Categories are distinguished by marker shape+colour (Maperitive cannot render SVG icons).
	//   every category also has a name label (min-zoom depending on importance),
	//   so a name is visible even for points with no (and never possible) picture icon.

	// --- Transport ---
	target : $regex("^poi transport (station)$")
		define
			min-zoom : 12
			shape : square
			shape-size : 13:3.5;16:4.5;19:6
			fill-color : #7981b0
			line-style : none
		draw : shape
		define
			min-zoom : 12
			text : name
			font-size : 13:6;16:7;19:8
			font-weight : normal
			text-color : #7a81b0
			text-offset-vertical : 130%
			text-halo-width : 0
		draw : text

