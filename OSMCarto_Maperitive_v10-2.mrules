			text-halo-width : 0
		draw : text


	target : winter piste downhill other
		define
			min-zoom : 11
			fill-color : #8a8a8a
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text


	target : winter sports area
		define
			min-zoom : 10
			fill-color : #eaf3fb
			line-style : none
		draw : fill
		define
			text : name
			text-color : #4a7ab0
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 11
			text-halo-width : 0
		draw : text

	target : tr aeroway runway area
		define
			min-zoom : 11
			fill-color : #bbbbcc
			line-style : none
		draw : fill

	// --- Ice and water (drawn last, so they cover zone boundaries) ---
	target : nat glacier
		define
			fill-color : #ddecec
			line-style : none
		draw : fill
		define
			text : name
			text-color : #7799bb
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 10
			text-halo-width : 0
		draw : text

	target : $regex("^(nat water|nat water mp)$")
		define
			fill-color : #a9d3df
			line-style : none
		draw : fill
		define
			text : name
			text-color : #4d80b3
			font-size : 11:8;16:13
			text-orientation : flow
			min-zoom : 11
			text-halo-width : 0
		draw : text

	target : $regex("^(nat water intermittent|nat water intermittent mp)$")
		define
			fill-color : #bcd6d6
			line-style : none
		draw : fill
		define
			text : name
			text-color : #5c8a8a
			font-size : 11:8;16:13
			text-orientation : flow
			min-zoom : 11
			text-halo-width : 0
		draw : text


	// ==================================================================
	// 2. BUILDINGS
	// ==================================================================
	// Public/notable buildings (churches, schools, hospitals...) are darker
	//   than ordinary buildings - same convention as OSM Carto.
	target : bld regular
		define
			min-zoom : 13
			fill-color : #d9d0c9
			line-style : none
		draw : fill

	target : bld major
		define
			min-zoom : 13
			fill-color : #c9beb5
			line-style : none
		draw : fill
		define
			text : name
			text-color : #70655c
			font-size : 10
			text-orientation : flow
			min-zoom : 17
			text-halo-width : 0
		draw : text

	// -- Bridge structure area (the deck itself, where mapped as a polygon) --
	//   A neutral dark tone representative of the various per-class bridge
	//   indicator colours used under the road/rail lines above.
	target : man made bridge area
		define
			min-zoom : 13
			fill-color : #5a4a42
			line-style : none
		draw : fill


	// ==================================================================
	// 3. WATERWAYS (LINES)
	// ==================================================================
	// Maperitive's rule language has no confirmed way to read an arbitrary
	// numeric tag (e.g. width=4.5) and use that value directly to drive a
	// rendered line-width - only fixed/zoom-interpolated values and simple
	// equality/set-membership tag comparisons are supported (no >=, <= etc.
	// in the query grammar). The practical, always-available substitute used
	// here is the waterway TYPE hierarchy, which in real-world OSM data is
	// already a strong proxy for real width: river is drawn widest, then
	// canal, stream, drain, ditch narrowest.
	target : water river
		define
			line-color : #aad2df
			line-width : 8:0.7;10:1.5;12:2.3;14:4.5;16:8;18:12
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #4e80b3
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 13
			text-halo-width : 0
		draw : text

	target : water canal
		define
			min-zoom : 11
			line-color : #aad3de
			line-width : 12:1;14:3;16:6;18:9
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #4d81b3
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 13
			text-halo-width : 0
		draw : text

	target : water stream
		define
			min-zoom : 12
			line-color : #abd4df
			line-width : 12:0.8;14:2;16:3;18:4
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #4d80b4
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 14
			text-halo-width : 0
		draw : text

	target : water drain
		define
			min-zoom : 13
			line-color : #abd3e0
			line-width : 13:0.6;17:1.5
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : water ditch
		define
			min-zoom : 15
			line-color : #aad4e0
			line-width : 0.5
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : water weir
		define
			min-zoom : 15
			line-color : #7a9ba6
			line-width : 2
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : water lock gate
		define
			min-zoom : 17
			line-color : #aaaaaa
			line-width : 3
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line


	// ==================================================================
	// 4. RAILWAYS
	// ==================================================================
	// Main line: white fill + grey dashed casing (imitates rails)
	target : rail main
		define
			min-zoom : 8
			line-color : #6e6e6e
			line-width : 8:0.6;10:1;13:2;15:3.5;18:6
			line-join : round
		for : tunnel=yes
			define
				line-color : #a8a4a0
		draw : line
		define
			min-zoom : 12
			line-color : #ffffff
			line-style : dashlong
			line-width : 12:1;15:2.5;18:5
		for : tunnel=yes
			define
				line-color : #e8e4e0
		draw : line
		define
			min-zoom : 14
			text : name
			text-color : #6f6e6e
			font-size : 14:8;17:11
			text-orientation : flow
			text-halo-width : 0
		draw : text

	// Branch/secondary line: single lighter-toned dashed stroke, no white
	// tie overlay - deliberately never looks like the main line above, so
	// the two stay unmistakably distinct and easy to separate into layers.
	target : rail branch
		define
			min-zoom : 10
			line-color : #a89484
			line-width : 10:0.4;13:1.2;15:2;18:3.5
			line-style : dash
			line-join : round
		draw : line
		define
			min-zoom : 15
			text : name
			text-color : #a99484
			font-size : 13:7;17:10
			text-orientation : flow
			text-halo-width : 0
		draw : text

	target : rail main service
		define
			min-zoom : 13
			line-color : #6e6f6e
			line-width : 0.6
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : rail narrow gauge
		define
			min-zoom : 12
			line-color : #6e6e6f
			line-width : 13:0.6;16:2
			line-style : dashdot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : rail light rail
		define
			min-zoom : 11
			line-color : #6d6e6e
			line-width : 12:0.6;15:2.5;18:4
			line-style : dashdot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #6e6d6e
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			min-zoom : 14
			text-halo-width : 0
		draw : text

	target : rail subway
		define
			min-zoom : 11
			line-color : #6e6e6d
			line-width : 12:0.6;15:2.5;18:4
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : rail tram
		define
			min-zoom : 13
			line-color : #6f6f6e
			line-width : 13:0.8;16:2
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : rail funicular
		define
			min-zoom : 12
			line-color : #6f6e6f
			line-width : 13:0.8;16:2
			line-style : dashdotdot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : rail miniature
		define
			min-zoom : 15
			line-color : #6e6f6f
			line-width : 0.6
			line-style : dot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : rail disused
		define
			min-zoom : 14
			line-color : #a8a8a8
			line-width : 0.6
			line-style : dot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

//	target : rail platform edge
//		define
//			min-zoom : 15
//			line-color : #8f8f8f
//			line-width : 13:1;17:3
//			line-style : solid
//			line-join : round
//			line-start-cap : round
//			line-end-cap : round
//		draw : line


	// ==================================================================
	// 5. AERIALWAYS AND LIFTS
	// ==================================================================
	target : aerial closed cabin
		define
			min-zoom : 11
			line-color : #808080
			line-width : 1.2
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #666666
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text

	target : aerial open
		define
			min-zoom : 12
			line-color : #999999
			line-width : 0.8
			line-style : dash
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #777777
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text

	target : aerial goods
		define
			min-zoom : 13
			line-color : #909090
			line-width : 0.6
			line-style : dot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line


	// ==================================================================
	// 6. POWER LINES
	// ==================================================================
	target : power line major
		define
			min-zoom : 13
			line-color : #888888
			line-width : 14:0.5;16:0.7;19:1.2
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : power line minor
		define
			min-zoom : 15
			line-color : #898888
			line-width : 16:0.3;18:0.5
			line-style : dash
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line


	// ==================================================================
	// 7. BARRIERS (LINES)
	// ==================================================================
	target : barrier wall
		define
			min-zoom : 15
			line-color : #7a7a6e
			line-width : 1
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : barrier retaining wall
		define
			min-zoom : 14
			line-color : #8a7a6a
			line-width : 1.4
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : barrier citywall
		define
			min-zoom : 12
			line-color : #8d968d
			line-width : 7:0.6;12:2.5;16:6
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #8e968d
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			min-zoom : 14
			text-halo-width : 0
		draw : text

	target : barrier fence
		define
			min-zoom : 16
			line-color : #abaaaa
			line-width : 0.6
			line-style : dot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line


	// ==================================================================
	// 8. FERRIES
	// ==================================================================
	target : ferry route
		define
			min-zoom : 6
			line-color : #6666ff
			line-width : 1.2
			line-style : dashdot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #6766ff
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 60%
			min-zoom : 10
			text-halo-width : 0
		draw : text


	// ==================================================================
	// 9. ADMINISTRATIVE BOUNDARIES
	// ==================================================================
	// Relation-based only (a directly tagged way is no longer matched
	//   separately, to avoid drawing the same boundary twice). Drawn ABOVE
	//   the roads (this rule appears later in the file), the purple colour
	//   family matches OSM Carto. Each level's name is shown offset to the
	//   side of the boundary line, never centred on it.
	target : admin state rel
		define
			min-zoom : 2
			line-color : #feffff
			line-width : 2:1;6:3;10:5
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	target : admin state rel
		define
			min-zoom : 2
			line-color : #8d618b
			line-width : 2:0.6;6:1.8;10:3.5
			line-style : dashdotdot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #5c3a5a
			font-size : 3:9;6:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 100%
			min-zoom : 3
			text-halo-width : 0
		draw : text

	target : admin region rel
		define
			min-zoom : 4
			line-color : #a37da1
			line-width : 4:0.8;8:1.8;12:3
			line-style : dashdot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #6b4a68
			font-size : 5:8;9:10
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 5
			text-halo-width : 0
		draw : text

	target : admin district rel
		define
			min-zoom : 8
			line-color : #a47da1
			line-width : 8:0.6;12:1.5;15:2.5
			line-style : dash
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #7a5a78
			font-size : 9:7;13:9
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 9
			text-halo-width : 0
		draw : text

	target : admin orp rel
		define
			min-zoom : 10
			line-color : #a37ea1
			line-width : 10:0.4;14:1
			line-style : dot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #89698a
			font-size : 8
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 11
			text-halo-width : 0
		draw : text

	target : admin municipality rel
		define
			min-zoom : 12
			line-color : #a37da2
			line-width : 12:0.4;15:1
			line-style : dot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #98789a
			font-size : 8
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 13
			text-halo-width : 0
		draw : text

	target : admin part rel
		define
			min-zoom : 13
			line-color : #a27da1
			line-width : 0.4
			line-style : dot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #a788a9
			font-size : 7
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 14
			text-halo-width : 0
		draw : text

	// --- National parks / CHKO (protected landscape areas) / natural
	//   monuments - plain single-colour line, no fill, no extra effects.
	//   boundary=protected_area covers CHKO and natural monuments alike,
	//   OSM does not distinguish them by a separate boundary sub-type.
	target : national park line rel
		define
			min-zoom : 8
			line-color : #4c7024
			line-width : 1.3
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #4d7024
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 9
			text-halo-width : 0
		draw : text

	target : protected area line rel
		define
			min-zoom : 9
			line-color : #7a9040
			line-width : 1
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : name
			text-color : #7b9040
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 10
			text-halo-width : 0
		draw : text


	// ==================================================================
	// 10. COASTLINE AND CONTOUR LINES
	// ==================================================================
	target : coastline
		define
			min-zoom : 3
			line-color : #6d94a3
			line-width : 1.2
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line


	// Contours ready for 'generate-contours interval=10' - major contours
	// every 50 m (thicker, with an elevation label), minor every 10 m
	// (thin). Elevation figures use text-orientation: flow (rotate with the
	// line, never bend along its curve - curved: false as well) and are
	// offset to sit BESIDE the contour line rather than centred on top of
	// it (text-offset-vertical). No halo (text-halo-width: 0).
	target : contour minor 10m
		define
			min-zoom : 12
			line-color : #a06a3c
			line-width : 0.4
		draw : contour

	target : contour major 50m
		define
			min-zoom : 10
			line-color : #a16a3c
			line-width : 10:0.4;13:1.1
			font-size : 10
			font-style : italic
			text-color : #a06b3c
			text-orientation : flow
			curved : false
			text-offset-vertical : 110%
			text-halo-width : 0
		draw : contour
		draw : text

	// -- Sea depth contours (bathymetry) - same treatment, blue tone --
	target : contour sea minor 10m
		define
			min-zoom : 12
			line-color : #6e94a3
			line-width : 0.4
		draw : contour

	target : contour sea major 50m
		define
			min-zoom : 10
			line-color : #6d95a3
			line-width : 10:0.4;13:1.1
			font-size : 10
			font-style : italic
			text-color : #6d94a4
			text-orientation : flow
			curved : false
			text-offset-vertical : 110%
			text-halo-width : 0
		draw : contour
		draw : text


	// ==================================================================
	// 11. ROADS - MAIN HIERARCHY (MOST IMPORTANT PART OF THE STYLE)
	// ==================================================================
	// Each class is a single stroke (colour + width), no separate casing.
	// Tunnels use a dashed line-style, indoor/building passages a dotted
	// line-style plus a muted grey, bridges get one extra, wider, distinctly
	// coloured stroke drawn first (so it peeks out from under the normal
	// stroke). Name/ref labels use text-orientation: flow (rotate as one
	// rigid block to match the line's direction, never bent along a curve).

	target : $regex("^(hw .*)$")
		define
			font-family : Noto Sans
			font-weight : bold
			text-align-horizontal : center
			text-align-vertical : center
			text-orientation : flow
		define
			line-join : round
			line-start-cap : round
			line-end-cap : round
			line-style : solid

		if : $regex("(hw motorway)$")
			define
				min-zoom : 6
				line-color : #dc4d76
				line-width : 6:0.5;8:1.2;10:2.3;12:4.3;13:7.3;15:12.2;17:22;19:32.9
			for : tunnel=yes
				define
					line-style : dash
			for : tunnel=building_passage
				define
					line-style : dot
					line-color : #c8c4bc
			for : bridge=yes
				define
					line-width : 6:1.2;8:2.4;10:3.7;12:6.1;13:9.8;15:15.9;17:26.8;19:39
					line-color : #7a1030
					line-start-cap : none
					line-end-cap : none
			draw : line
			define
				line-width : 6:0.5;8:1.2;10:2.3;12:4.3;13:7.3;15:12.2;17:22;19:32.9
				line-color : #dd4d76
				line-start-cap : round
				line-end-cap : round
			draw : line
			define
				min-zoom : 10
				max-zoom : 20
				text : ref
				font-size : 11
				text-color : #fffffd
				text-halo-width : 0
				shape : custom
				shape-def : p:#2255aa;pw:4;f:#2255aa;m:-10,-7;l:10,-7;l:10,7;l:-10,7;z
				shield-padding-left : 5
				shield-padding-right : 5
				shield-padding-top : 5
				shield-padding-bottom : 5
				shield-resize-mode : free
				text-halo-width : 0
			draw : shield
			define
				min-zoom : 1
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0.3
				text : name
				font-weight : normal
				text-color : #7b1030
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw trunk)$")
			define
				min-zoom : 6
				line-color : #c0603f
				line-width : 6:0.5;8:1.2;10:2.3;12:4.3;13:7.3;15:12.2;17:22;19:32.9
			for : tunnel=yes
				define
					line-style : dash
			for : tunnel=building_passage
				define
					line-style : dot
					line-color : #c8c4bd
			for : bridge=yes
				define
					line-width : 6:1.2;8:2.4;10:3.7;12:6.1;13:9.8;15:15.9;17:26.8;19:39
					line-color : #6b2c15
					line-start-cap : none
					line-end-cap : none
			draw : line
			define
				line-width : 6:0.5;8:1.2;10:2.3;12:4.3;13:7.3;15:12.2;17:22;19:32.9
				line-color : #c1603f
				line-start-cap : round
				line-end-cap : round
			draw : line
			define
				min-zoom : 10
				max-zoom : 20
				text : ref
				font-size : 11
				text-color : #fffffc
				text-halo-width : 0
				shape : custom
				shape-def : p:#2f7a2f;pw:4;f:#2f7a2f;m:-10,-7;l:10,-7;l:10,7;l:-10,7;z
				shield-padding-left : 5
				shield-padding-right : 5
				shield-padding-top : 5
				shield-padding-bottom : 5
				shield-resize-mode : free
				text-halo-width : 0
			draw : shield
			define
				min-zoom : 1
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				text-color : #6c2c15
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw primary)$")
			define
				min-zoom : 8
				line-color : #c98a1e
				line-width : 8:1.2;9:1.7;10:2.2;11:2.4;12:4.3;13:6.1;15:12.2;17:22;19:32.9
			for : tunnel=yes
				define
					line-style : dash
			for : tunnel=building_passage
				define
					line-style : dot
					line-color : #c8c4be
			for : bridge=yes
				define
					line-width : 8:2.4;9:3.7;10:4.3;11:4.9;12:6.1;13:8.5;15:15.9;17:26.8;19:39
					line-color : #6b4300
					line-start-cap : none
					line-end-cap : none
			draw : line
			define
				line-width : 8:1.2;9:1.7;10:2.2;11:2.4;12:4.3;13:6.1;15:12.2;17:22;19:32.9
				line-color : #ca8a1e
				line-start-cap : round
				line-end-cap : round
			draw : line
			define
				min-zoom : 13
				max-zoom : 20
				text : ref
				font-size : 9
				text-color : #503000
				text-halo-width : 0
				shape : custom
				shape-def : p:#e0a838;pw:2;f:#e0a838;m:-9,-6;l:9,-6;l:9,6;l:-9,6;z
				shield-padding-left : 3
				shield-padding-right : 3
				shield-padding-top : 2
				shield-padding-bottom : 2
				shield-resize-mode : free
				text-halo-width : 0
			draw : shield
			define
				min-zoom : 1
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0.3
				text : name
				font-weight : normal
				text-color : #6c4300
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw secondary)$")
			define
				min-zoom : 9
				line-color : #8a9505
				line-width : 9:1.2;10:1.3;11:1.3;12:4.3;13:6.1;15:11;17:22;19:32.9
			for : tunnel=yes
				define
					line-style : dash
			for : tunnel=building_passage
				define
					line-style : dot
					line-color : #c8c4bf
			for : bridge=yes
				define
					line-width : 9:2.4;10:2.7;11:3;12:6.1;13:8.5;15:14.6;17:26.8;19:39
					line-color : #4a5203
					line-start-cap : none
					line-end-cap : none
			draw : line
			define
				line-width : 9:1.2;10:1.3;11:1.3;12:4.3;13:6.1;15:11;17:22;19:32.9
				line-color : #8b9505
				line-start-cap : round
				line-end-cap : round
			draw : line
			define
				min-zoom : 13
				max-zoom : 20
				text : ref
				font-size : 9
				text-color : #364000
				text-halo-width : 0
				shape : custom
				shape-def : p:#d3d95a;pw:2;f:#d3d95a;m:-9,-6;l:9,-6;l:9,6;l:-9,6;z
				shield-padding-left : 3
				shield-padding-right : 3
				shield-padding-top : 2
				shield-padding-bottom : 2
				shield-resize-mode : free
				text-halo-width : 0
			draw : shield
			define
				min-zoom : 1
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				text-color : #4b5203
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw tertiary)$")
			define
				min-zoom : 10
				line-color : #a8a29a
				line-width : 10:0.9;12:3;13:4.9;15:11;17:22;19:32.9
			for : tunnel=yes
				define
					line-style : dash
			for : tunnel=building_passage
				define
					line-style : dot
					line-color : #c8c4c0
			for : bridge=yes
				define
					line-width : 10:1.8;12:4.9;13:7.3;15:14.6;17:26.8;19:39
					line-color : #5a544c
					line-start-cap : none
					line-end-cap : none
			draw : line
			define
				line-width : 10:0.9;12:3;13:4.9;15:11;17:22;19:32.9
				line-color : #a9a29a
				line-start-cap : round
				line-end-cap : round
			draw : line
			define
				min-zoom : 14
				max-zoom : 20
				text : ref
				font-size : 9
				text-color : #3b3b3b
				text-halo-width : 0
			draw : text
			define
				min-zoom : 1
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				text-color : #5b544c
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw unclassified|hw residential)$")
			define
				min-zoom : 12
				line-color : #bbb5ac
				line-width : 12:0.7;13:3;15:6.1;17:14.6;19:20.7
			for : tunnel=yes
				define
					line-style : dash
			for : tunnel=building_passage
				define
					line-style : dot
					line-color : #c8c4c1
			for : bridge=yes
				define
					line-width : 12:1.5;13:4.9;15:9.8;17:19.5;19:26.8
					line-color : #645e55
					line-start-cap : none
					line-end-cap : none
			draw : line
			define
				line-width : 12:0.7;13:3;15:6.1;17:14.6;19:20.7
				line-color : #bcb5ac
				line-start-cap : round
				line-end-cap : round
			draw : line
			define
				min-zoom : 15
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				text-color : #655e55
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw living street)$")
			define
				min-zoom : 13
				line-color : #c7c1a3
				line-width : 13:2.4;15:6.1;17:14.6;19:20.7
			for : tunnel=yes
				define
					line-style : dash
			for : tunnel=building_passage
				define
					line-style : dot
					line-color : #c8c4c2
			draw : line
			define
				min-zoom : 15
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				text-color : #6b6650
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw pedestrian way)$")
			define
				min-zoom : 14
				line-color : #a6a6c8
				line-width : 14:3.7;15:6.1;16:7.3;17:14.6;19:20.7
			for : tunnel=yes
				define
					line-style : dash
			for : tunnel=building_passage
				define
					line-style : dot
					line-color : #c8c4c3
			draw : line
			define
				min-zoom : 16
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				text-color : #55555f
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw service)$")
			define
				min-zoom : 14
				line-color : #c2bcb2
				line-width : 14:2.4;16:4.3;17:8.5;19:13.4
			for : tunnel=yes
				define
					line-style : dash
			for : tunnel=building_passage
				define
					line-style : dot
					line-color : #c8c4c4
			draw : line
			define
				min-zoom : 17
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				font-size : 9
				text-color : #676666
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw road unknown|hw construction generic)$")
			define
				min-zoom : 13
				line-color : #ddd8d0
				line-width : 13:1;15:3;17:6
				line-style : dot
			draw : line

		elseif : $regex("(hw track)$")
			define
				min-zoom : 13
				line-color : #996600
				line-width : 13:0.6;15:1.3;18:2
				line-style : dash
			for : tunnel=yes
				define
					line-style : dot
			for : tracktype=grade1
				define
					line-style : solid
			for : tracktype=grade3
				define
					line-style : dashdot
			for : tracktype=grade4 OR tracktype=grade5
				define
					line-style : dashdotdot
			draw : line
			define
				min-zoom : 15
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				font-size : 9
				text-color : #8a5c00
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw footway)$")
			define
				min-zoom : 14
				line-color : #e05343
				line-width : 14:0.7;16:1.3;19:1.6
				line-style : dot
			for : tunnel=yes
				define
					line-style : dashdot
			for : tunnel=building_passage
				define
					line-color : #c8c4c5
			draw : line
			define
				min-zoom : 17
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				font-size : 8
				text-color : #a24236
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw cycleway)$")
			define
				min-zoom : 13
				line-color : #2b6bff
				line-width : 13:0.7;16:0.9;19:1.3
				line-style : dot
			for : tunnel=yes
				define
					line-style : dashdot
			for : tunnel=building_passage
				define
					line-color : #c8c4c6
			draw : line
			define
				min-zoom : 17
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				font-size : 8
				text-color : #2b5fdf
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw bridleway)$")
			define
				min-zoom : 13
				line-color : #3a8f3a
				line-width : 13:0.3;15:1.2;19:1.8
				line-style : dash
			for : tunnel=yes
				define
					line-style : dashdotdot
			draw : line

		elseif : $regex("(hw path)$")
			define
				min-zoom : 14
				line-color : #6e7c6d
				line-width : 14:0.6;16:1;19:1.5
				line-style : dashdot
			for : tunnel=yes
				define
					line-style : dot
			for : tunnel=building_passage
				define
					line-color : #c8c4c7
			draw : line

		elseif : $regex("(hw ski nordic)$")
			define
				min-zoom : 11
				line-color : #2255cd
				line-width : 11:0.5;15:1.2;18:1.8
				line-style : dashdotdot
			draw : line
			define
				min-zoom : 14
				map.rendering.lflp.min-buffer-space : 0
				map.rendering.lflp.max-allowed-corner-angle : 0
				map.rendering.lflp.max-compression : 0
				text : name
				font-weight : normal
				font-size : 8
				text-color : #2255ce
				text-halo-width : 0
			draw : text

		elseif : $regex("(hw raceway)$")
			define
				min-zoom : 12
				line-color : #ffc0cb
				line-width : 12:1;15:5;18:9
			draw : line

		elseif : $regex("(hw bus guideway)$")
			define
				min-zoom : 13
				line-color : #6699ff
				line-width : 13:1;16:3
				line-style : dash
			draw : line

		else
			stop

	// -- Aircraft taxiway (centreline, drawn as a line where the taxiway is
	//    not mapped as a closed-way area) --
	target : tr aeroway taxiway line
		define
			min-zoom : 11
			line-color : #9a9ac0
			line-width : 11:0.6;14:1.5;17:3
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line

	// -- Golf: each hole's centreline, labelled with its hole number/name --
	target : golf hole line
		define
			min-zoom : 14
			line-color : #40ae2a
			line-width : 0.8
			line-style : dot
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line
		define
			text : ref
			text-color : #2a7a1a
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			min-zoom : 15
			text-halo-width : 0
		draw : text

	target : golf cartpath
		define
			min-zoom : 13
			line-color : #c9c9a0
			line-width : 13:0.5;17:1.5
			line-style : solid
			line-join : round
			line-start-cap : round
			line-end-cap : round
		draw : line


	target : $regex("^(hw .* link)$")
		define
			line-join : round
			line-start-cap : round
			line-end-cap : round
		if : $regex("(motorway link)$")
			define
				min-zoom : 10
				line-color : #dc4d77
				line-width : 10:1;12:1.5;13:4;15:7.8;17:12;19:16
			draw : line
		elseif : $regex("(trunk link)$")
			define
				min-zoom : 10
				line-color : #c06040
				line-width : 10:1;12:1.5;13:4;15:7.8;17:12;19:16
			draw : line
		elseif : $regex("(primary link)$")
			define
				min-zoom : 11
				line-color : #c98a1f
				line-width : 11:1;12:1.5;13:4;15:7.8;17:12;19:16
			draw : line
		elseif : $regex("(secondary link)$")
			define
				min-zoom : 12
				line-color : #8a9506
				line-width : 12:1.5;13:4;15:7;17:12;19:16
			draw : line
		elseif : $regex("(tertiary link)$")
			define
				min-zoom : 12
				line-color : #a8a29b
				line-width : 12:1.5;13:3;15:7;17:12;19:16
			draw : line
		else
			stop

	// -- steps: cross-ticks instead of a continuous line --
	// Steps: a single continuous line (not repeated tick-mark objects, to
	// keep the export compact), styled to read as a stairway and to flow
	// naturally on from a footway - a dense dash pattern in a unique tone
	// from the same warm colour family as footway.
	target : hw steps
		define
			min-zoom : 15
			line-color : #d8493a
			line-width : 15:1;17:2;19:2
			line-style : dashdotdot
		draw : line
		define
			min-zoom : 1
			map.rendering.lflp.min-buffer-space : 0
			map.rendering.lflp.max-allowed-corner-angle : 0
			map.rendering.lflp.max-compression : 0
			text : name
			font-size : 8
			text-color : #a24237
			text-halo-width : 0
		draw : text

	// -- mini roundabout (centre island) --
	target : hw mini roundabout centre
		define
			min-zoom : 15
			shape : circle
			shape-size : 15:4;18:10
			line-color : #bcbcbe
			line-width : 1
			fill-color : #fffff5
		draw : shape

	// -- overlay for restricted access (private/destination) --
	target : hw access private
		define
			min-zoom : 14
			line-color : #efa9a9
			line-width : 14:1;16:2;18:3
			line-style : dash
		draw : line

	target : hw access destination
		define
			min-zoom : 14
			line-color : #c2e0ff
			line-width : 14:1;16:2;18:3
			line-style : dash
		draw : line


	// ==================================================================
	// 12. WAYMARKED ROUTES FROM RELATIONS - drawn AFTER roads so the
	// ==================================================================
	// route overlay stays continuously visible along its whole length,
	// instead of being covered by wide road fills (same symbol type = later
	// rule wins). The underlying street/track/path still renders normally
	// with its own highway-based style from section 11 - this is a distinct,
	// uniquely-coloured OVERLAY on top of it, easy to isolate as its own
	// Illustrator layer regardless of which road types the route follows.
	// Hiking, cycling, MTB, horse riding, ski, long-distance (E-paths) and
	//   public transport. Each category has its own unique colour, so it
	//   can be filtered by stroke colour in Illustrator. Where a relation
	//   has both a ref (route number) and a name, both are shown - the ref
	//   in a small rectangular shield, the name offset further out so the
	//   two never overlap. Following the approach used by waymarkedtrails.org
	//   and mtbmap.cz, the route line itself is nudged sideways with
	//   line-offset so it runs BESIDE the path rather than exactly on its
	//   centreline - this is what keeps several overlapping routes readable.
	target : route hiking intl
		define
			min-zoom : 8
			line-color : #c02020
			line-width : 1.6
			line-style : dashdot
			line-join : round
			line-start-cap : round
			line-end-cap : round
			line-offset : 3
			line-offset-sides : left
		draw : line
		define
			text : ref
			text-color : #c12020
			font-size : 13:8;16:8;19:8
			font-weight : normal
			text-orientation : flow
			min-zoom : 11
			shape : custom
			shape-def : p:#f0b0b0;pw:2;f:#f0b0b0;m:-8,-6;l:8,-6;l:8,6;l:-8,6;z
			shield-padding-left : 3
			shield-padding-right : 3
			shield-padding-top : 2
			shield-padding-bottom : 2
			shield-resize-mode : free
			text-halo-width : 0
		draw : shield
		define
			text : name
			text-color : #c02120
			font-size : 13:8;16:8;19:8
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 11
			text-halo-width : 0
		draw : text

	target : route hiking national
		define
			min-zoom : 9
			line-color : #c02021
			line-width : 1.3
			line-style : dash
			line-join : round
			line-start-cap : round
			line-end-cap : round
			line-offset : 4
			line-offset-sides : left
		draw : line
		define
			text : name
			text-color : #bf2020
			font-size : 13:8;16:8;19:8
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 11
			text-halo-width : 0
		draw : text

	target : route hiking regional
		define
			min-zoom : 10
			line-color : #2060c0
			line-width : 1
			line-style : dash
			line-join : round
			line-start-cap : round
			line-end-cap : round
			line-offset : 5
			line-offset-sides : right
		draw : line
		define
			text : name
			text-color : #2160c0
			font-size : 13:8;16:8;19:8
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 12
			text-halo-width : 0
		draw : text

	target : route cycling intl
		define
			min-zoom : 8
			line-color : #008000
			line-width : 1.6
			line-style : dashdot
			line-join : round
			line-start-cap : round
			line-end-cap : round
			line-offset : 8
			line-offset-sides : left
		draw : line
		define
			text : ref
			text-color : #018000
			font-size : 13:8;16:8;19:8
			font-weight : normal
			text-orientation : flow
			min-zoom : 11
			shape : custom
			shape-def : p:#a8dba8;pw:2;f:#a8dba8;m:-8,-6;l:8,-6;l:8,6;l:-8,6;z
			shield-padding-left : 3
			shield-padding-right : 3
			shield-padding-top : 2
			shield-padding-bottom : 2
			shield-resize-mode : free
			text-halo-width : 0
		draw : shield
		define
			text : name
			text-color : #008100
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 11
			text-halo-width : 0
		draw : text

	target : route cycling national
		define
			min-zoom : 9
			line-color : #008001
			line-width : 1.3
			line-style : dash
			line-join : round
			line-start-cap : round
			line-end-cap : round
			line-offset : 9
			line-offset-sides : left
		draw : line
		define
			text : name
			text-color : #007f00
			font-size : 13:8;16:8;19:8
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 11
			text-halo-width : 0
		draw : text

	target : route cycling regional
		define
			min-zoom : 10
			line-color : #20a020
			line-width : 1
			line-style : dash
			line-join : round
			line-start-cap : round
			line-end-cap : round
			line-offset : 10
			line-offset-sides : left
		draw : line
		define
			text : name
			text-color : #21a020
			font-size : 13:8;16:8;19:8
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 12
			text-halo-width : 0
		draw : text


	// MTB: direction-of-travel arrows for explicitly one-way singletrack.
	target : route mtb
		define
			min-zoom : 10
			line-color : #e07800
			line-width : 1.1
			line-style : dashdot
			line-offset : 3
			line-offset-sides : left
		draw : line
		define
			min-zoom : 12
			text : ref
			font-size : 8:8;16:12
			text-color : #e17800
			text-halo-width : 0
			shape : custom
			shape-def : p:#f5c98a;pw:2;f:#f5c98a;m:-8,-6;l:8,-6;l:8,6;l:-8,6;z
			shield-padding-left : 3
			shield-padding-right : 3
			shield-padding-top : 2
			shield-padding-bottom : 2
			shield-resize-mode : free
			text-halo-width : 0
		draw : shield
		define
			min-zoom : 12
			text : name
			text-color : #e07900
			text-orientation : flow
			text-offset-vertical : 110%
			text-halo-width : 0
		draw : text
		for : oneway=yes
			define
				min-zoom : 14
				shape : custom
				shape-def : f:#e07801;p:#e07801;-3,2;-3,-2;3,0;Z
				shape-size : 6
				shape-spacing : 10
				shape-mode : linear
				shape-orientation : flow
				line-style : none
			draw : shape

	target : route horse
		define
			min-zoom : 10
			line-color : #a0622d
			line-width : 1.1
			line-style : dot
			line-join : round
			line-start-cap : round
			line-end-cap : round
			line-offset : 6
			line-offset-sides : left
		draw : line
		define
			text : name
			text-color : #a1622d
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 12
			text-halo-width : 0
		draw : text

	target : route ski
		define
			min-zoom : 9
			line-color : #2255cc
			line-width : 1.1
			line-style : dashdotdot
			line-join : round
			line-start-cap : round
			line-end-cap : round
			line-offset : 11
			line-offset-sides : left
		draw : line
		define
			text : name
			text-color : #2355cc
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 11
			text-halo-width : 0
		draw : text

	target : route eway
		define
			min-zoom : 6
			line-color : #800080
			line-width : 1.9
			line-style : dashdot
			line-join : round
			line-start-cap : round
			line-end-cap : round
			line-offset : 2
			line-offset-sides : left
		draw : line
		define
			text : ref
			text-color : #810080
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			min-zoom : 8
			shape : custom
			shape-def : p:#dcb3dc;pw:2;f:#dcb3dc;m:-8,-6;l:8,-6;l:8,6;l:-8,6;z
			shield-padding-left : 3
			shield-padding-right : 3
			shield-padding-top : 2
			shield-padding-bottom : 2
			shield-resize-mode : free
			text-halo-width : 0
		draw : shield
		define
			text : name
			text-color : #800180
			font-size : 13:8;16:12
			font-weight : normal
			text-orientation : flow
			text-offset-vertical : 110%
			min-zoom : 8
			text-halo-width : 0
		draw : text

	target : route bus
