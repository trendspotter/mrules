			min-zoom : 13
			text-halo-width : 0
		draw : text

	target : lz beach resort
		define
			fill-color : #fff2ba
			line-style : none
		draw : fill

	// --- Transport - parking and airports (areas) ---
	target : tr parking area
		define
			min-zoom : 13
			fill-color : #eeeeee
			line-style : none
		draw : fill

	target : tr aeroway apron
		define
			fill-color : #dadae0
			line-style : none
		draw : fill

	target : tr aeroway terminal
		define
			fill-color : #e9e7f0
			line-style : none
		draw : fill

	target : tr aerodrome area
		define
			fill-color : #e9e8e3
			line-style : none
		draw : fill

	target : tr heliport area
		define
			min-zoom : 12
			fill-color : #e2e1de
			line-style : none
		draw : fill
		define
			text : name
			text-color : #6b6a67
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text

	target : rail platform area
		define
			min-zoom : 16
			fill-color : #dcdcdc
			line-style : none
		draw : fill

	target : tr pedestrian area
		define
			min-zoom : 14
			fill-color : #a6a6c9
			line-style : none
		draw : fill

	target : tr footway area
		define
			min-zoom : 15
			fill-color : #e05344
			line-style : none
		draw : fill

	// --- Winter sports (piste difficulty colours follow the standard
	//   European convention: green/blue/red/black) ---
	target : winter piste downhill novice
		define
			min-zoom : 11
			fill-color : #3fae2a
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text


	target : winter piste downhill easy
		define
			min-zoom : 11
			fill-color : #2a6fce
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text


	target : winter piste downhill intermediate
		define
			min-zoom : 11
			fill-color : #d02a2a
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;16:13
			text-orientation : flow
			min-zoom : 13
			text-halo-width : 0
		draw : text


	target : winter piste downhill advanced
		define
			min-zoom : 11
			fill-color : #1a1a1a
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;16:13
