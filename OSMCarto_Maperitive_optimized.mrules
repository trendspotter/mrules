		draw : line
		define
			text : name
			text-color : #336699
			font-size : 7:7;10:9;12:11;14:13;16:14
			text-orientation : flow
			text-halo-width : 0
			min-zoom : 9
		draw : text

	target : water canal
		define
			min-zoom : 8
			line-color : #77aadd
			line-width : 8:0.5;10:0.8;12:1.2;14:1.6;16:2.2;18:3
