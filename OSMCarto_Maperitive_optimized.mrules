// MAPERITIVE OPTIMIZED STYLESHEET
// Compact, zoom-aware rendering with systematic color allocation
// Designed for SVG export to print and further design work

features
	points
		// Natural features
		poi natural peak : natural=peak
		poi natural volcano : natural=volcano
		poi natural cave : natural=cave_entrance
		poi natural spring : natural=spring
		poi natural waterfall : waterway=waterfall
		
		// Settlements
		place country : place=country
		place state : place=state
		place capital : place=city AND capital=yes
		place city : place=city AND NOT capital=yes
		place town : place=town
		place village : place=village
		place hamlet : place=hamlet
		
		// Transport hubs
		poi transport railway : railway=station OR railway=halt
		poi transport tram : railway=tram_stop
		poi transport subway : railway=subway_entrance
		poi transport aerodrome : aeroway=aerodrome
		poi transport bus : amenity=bus_station
		poi transport ferry : amenity=ferry_terminal
		
		// Services
		poi service fuel : amenity=fuel
		poi service parking : amenity=parking AND NOT (parking=multi-storey OR parking=underground)
		poi service parking multi : parking=multi-storey OR parking=underground
		poi service charging : amenity=charging_station
		poi service bicycle : amenity=bicycle_rental OR amenity=bicycle_repair_station
		
		// Commerce & food
		poi shop supermarket : shop=supermarket
		poi shop bakery : shop=bakery OR shop=pastry
		poi shop restaurant : amenity=restaurant
		poi shop cafe : amenity=cafe
		poi shop bar : amenity=bar OR amenity=pub
		
		// Health & social
		poi health hospital : amenity=hospital
		poi health pharmacy : amenity=pharmacy
		poi health doctor : amenity=doctors
		
		// Civic
		poi civic town : amenity=townhall
		poi civic police : amenity=police
		poi civic fire : amenity=fire_station
		poi civic post : amenity=post_office
		
		// Culture
		poi culture museum : tourism=museum
		poi culture theatre : amenity=theatre
		poi culture cinema : amenity=cinema
		
		// Religion
		poi religion christian : amenity=place_of_worship AND religion=christian
		poi religion other : amenity=place_of_worship
		
		// Education
		poi edu school : amenity=school
		poi edu university : amenity=university
		poi edu library : amenity=library
		
		// Leisure
		poi leisure sport : leisure=sports_centre OR leisure=fitness_centre
		poi leisure golf : leisure=golf_course
		poi leisure pool : leisure=swimming_pool
		poi leisure playground : leisure=playground

	lines
		// Highway network - primary
		hw motorway : highway=motorway OR (highway=construction AND construction=motorway)
		hw trunk : highway=trunk OR (highway=construction AND construction=trunk)
		hw primary : highway=primary OR (highway=construction AND construction=primary)
		
		// Highway network - secondary
		hw secondary : highway=secondary OR (highway=construction AND construction=secondary)
		hw tertiary : highway=tertiary OR (highway=construction AND construction=tertiary)
		hw residential : highway=residential OR (highway=construction AND construction=residential)
		hw unclassified : highway=unclassified OR (highway=construction AND construction=unclassified)
		
		// Special road types
		hw living street : highway=living_street
		hw service : highway=service
		hw track : highway=track
		
		// Pedestrian & cycling
		hw footway : highway=footway
		hw cycleway : highway=cycleway
		hw bridleway : highway=bridleway
		hw path : highway=path
		hw steps : highway=steps
		
		// Railways
		rail main : railway=rail AND NOT service AND NOT usage=branch
		rail branch : railway=rail AND usage=branch
		rail service : railway=rail AND service
		rail light : railway=light_rail
		rail tram : railway=tram
		rail subway : railway=subway
		
		// Waterways - size hierarchy
		water river : waterway=river
		water canal : waterway=canal
		water stream : waterway=stream
		water small : waterway=drain OR waterway=ditch
		
		// Administrative boundaries
		admin state : relation[type=boundary AND boundary=administrative AND admin_level=2].way[]
		admin region : relation[type=boundary AND boundary=administrative AND admin_level=4].way[]
		admin district : relation[type=boundary AND boundary=administrative AND admin_level=6].way[]
		admin municipality : relation[type=boundary AND boundary=administrative AND admin_level=8].way[]
		
		// Protected areas
		protected national : relation[type=boundary AND boundary=national_park].way[]
		protected area : relation[type=boundary AND boundary=protected_area].way[]
		
		// Natural features
		coastline : natural=coastline
		cliff : natural=cliff
		
		// Contours
		contour major : contour[elevation_multiplier=50]
		contour minor : contour[elevation_multiplier=10]
		
		// Waymarked routes - visible only at appropriate zoom
		route hiking int : relation[type=route AND route=hiking AND network=iwn].way[]
		route hiking natl : relation[type=route AND route=foot AND network=nwn].way[]
		route cycling int : relation[type=route AND route=bicycle AND network=icn].way[]
		route cycling natl : relation[type=route AND route=bicycle AND network=ncn].way[]
		route cycling reg : relation[type=route AND route=bicycle AND @isOneOf(network,rcn,lcn)].way[]
		route mtb : relation[type=route AND route=mtb].way[]
		
		// Infrastructure
		power line : power=line
		barrier wall : barrier=wall OR barrier=fence

	areas
		// Water
		water base : natural=water OR waterway=riverbank OR landuse=reservoir OR landuse=basin
		water seasonal : (natural=water OR landuse=reservoir) AND (intermittent=yes OR seasonal=yes)
		
		// Natural vegetation
		forest : landuse=forest OR natural=wood
		scrub : natural=scrub OR natural=shrubbery
		grassland : natural=grassland OR natural=fell OR natural=meadow
		wetland : natural=wetland OR natural=marsh
		bare rock : natural=bare_rock OR natural=scree
		sand : natural=sand OR natural=beach
		glacier : natural=glacier
		
		// Agriculture
		farmland : landuse=farmland
		meadow : landuse=meadow
		orchard : landuse=orchard OR landuse=vineyard
		
		// Built environment
		residential : landuse=residential
		commercial : landuse=commercial
		retail : landuse=retail
		industrial : landuse=industrial OR landuse=railway
		construction : landuse=construction OR landuse=brownfield
		
		// Recreation
		park : leisure=park
		sports : leisure=sports_centre OR leisure=pitch OR leisure=track OR leisure=stadium
		playground : leisure=playground
		
		// Infrastructure
		parking : amenity=parking
		aerodrome : aeroway=aerodrome
		
		// Cemeteries and special
		cemetery : landuse=cemetery OR amenity=grave_yard
		military : landuse=military OR military=barracks
		
		// Buildings
		building : building

properties
	map-background-color : #f2efe9
	map-background-opacity : 1
	map-sea-color : #aad3df
	
	font-family : Noto Sans
	font-weight : normal
	font-stretch : 0.92
	text : name
	text-color : #222222
	text-align-horizontal : center
	text-align-vertical : center
	text-orientation : flow
	text-avoid-overlaps : false
	map.rendering.detect-label-collision : false

rules

	// ========== AREA FEATURES ==========
	
	target : water base
		define
			fill-color : #aad3df
			line-style : none
		draw : fill

	target : water seasonal
		define
			fill-color : #c5dfe8
			line-style : none
		draw : fill

	target : forest
		define
			fill-color : #add19e
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;14:11;18:15
			text-orientation : flow
			min-zoom : 11
			text-halo-width : 0
		draw : text

	target : scrub
		define
			fill-color : #c8d7ab
			line-style : none
		draw : fill

	target : grassland
		define
			fill-color : #d5e8b0
			line-style : none
		draw : fill

	target : meadow
		define
			fill-color : #d5e8b0
			line-style : none
		draw : fill

	target : wetland
		define
			fill-color : #d3e8d3
			line-style : none
		draw : fill

	target : bare rock
		define
			fill-color : #c5c3c3
			line-style : none
		draw : fill

	target : sand
		define
			fill-color : #f5e9c6
			line-style : none
		draw : fill

	target : glacier
		define
			fill-color : #e0f0f5
			line-style : none
		draw : fill

	target : farmland
		define
			fill-color : #eef0d5
			line-style : none
		draw : fill

	target : orchard
		define
			fill-color : #aedfa3
			line-style : none
		draw : fill

	target : residential
		define
			fill-color : #e0dfdf
			line-style : none
		draw : fill

	target : commercial
		define
			fill-color : #f2dad9
			line-style : none
		draw : fill

	target : retail
		define
			fill-color : #ffd6d1
			line-style : none
		draw : fill

	target : industrial
		define
			fill-color : #ebdbe8
			line-style : none
		draw : fill

	target : construction
		define
			fill-color : #c7c7b4
			line-style : none
		draw : fill

	target : park
		define
			fill-color : #c8facc
			line-style : none
		draw : fill
		define
			text : name
			text-color : #2a6b1a
			font-size : 10:8;14:11;18:15
			text-orientation : flow
			min-zoom : 12
			text-halo-width : 0
		draw : text

	target : sports
		define
			fill-color : #88e0be
			line-style : none
		draw : fill

	target : playground
		define
			fill-color : #ccfef0
			line-style : none
		draw : fill

	target : parking
		define
			min-zoom : 13
			fill-color : #eeeeee
			line-style : none
		draw : fill

	target : aerodrome
		define
			fill-color : #e9e8e3
			line-style : none
		draw : fill

	target : cemetery
		define
			fill-color : #aacbaf
			line-style : none
		draw : fill

	target : military
		define
			fill-color : #f55555
			line-style : none
		draw : fill

	target : building
		define
			min-zoom : 13
			fill-color : #cfcfcf
			line-style : none
		draw : fill

	// ========== LINE FEATURES ==========
	
	// Motorways & major routes
	target : hw motorway
		define
			min-zoom : 4
			line-color : #f76f00
			line-width : 4:0.8;6:1.2;8:1.8;10:2.5;12:3.5;14:4.5;16:6
			line-style : solid
		draw : line
		define
			text : ref
			text-color : #ffffff
			font-size : 6:7;8:9;10:11;12:13
			text-background-color : #f76f00
			text-halo-width : 0
			min-zoom : 8
		draw : text

	target : hw trunk
		define
			min-zoom : 5
			line-color : #ff9933
			line-width : 4:0.6;6:1;8:1.5;10:2;12:3;14:3.8;16:5
			line-style : solid
		draw : line
		define
			text : ref
			text-color : #ffffff
			font-size : 6:6;8:8;10:10;12:12
			text-background-color : #ff9933
			text-halo-width : 0
			min-zoom : 9
		draw : text

	target : hw primary
		define
			min-zoom : 6
			line-color : #ffcc33
			line-width : 5:0.5;7:0.9;9:1.3;11:1.8;13:2.5;15:3.5;17:4.5
			line-style : solid
		draw : line
		define
			text : name
			text-color : #333333
			font-size : 8:8;11:10;14:12;17:14
			text-halo-width : 0
			min-zoom : 10
		draw : text

	target : hw secondary
		define
			min-zoom : 7
			line-color : #ffdd77
			line-width : 6:0.4;8:0.8;10:1.2;12:1.6;14:2.2;16:3;18:4
			line-style : solid
		draw : line
		define
			text : name
			text-color : #333333
			font-size : 10:8;12:10;14:11;16:12
			text-halo-width : 0
			min-zoom : 12
		draw : text

	target : hw tertiary
		define
			min-zoom : 8
			line-color : #f0f0f0
			line-width : 7:0.3;9:0.7;11:1;13:1.4;15:1.9;17:2.5
			line-style : solid
		draw : line
		define
			text : name
			text-color : #333333
			font-size : 11:7;13:9;15:10;17:11
			text-halo-width : 0
			min-zoom : 14
		draw : text

	target : hw residential
		define
			min-zoom : 9
			line-color : #ffffff
			line-width : 8:0.3;10:0.6;12:0.9;14:1.2;16:1.6;18:2.2
			line-style : solid
		draw : line
		define
			text : name
			text-color : #444444
			font-size : 12:6;14:8;16:9;18:10
			text-halo-width : 0
			min-zoom : 15
		draw : text

	target : hw unclassified
