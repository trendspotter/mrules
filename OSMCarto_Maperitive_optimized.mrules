			min-zoom : 13
			line-color : #dd9999
			line-width : 12:0.3;14:0.6;16:0.9;18:1.3
			line-style : dotted
		draw : line

	target : hw path
		define
			min-zoom : 14
			line-color : #999999
			line-width : 13:0.2;15:0.4;17:0.7;19:1
			line-style : dotted
		draw : line

	target : hw steps
		define
			min-zoom : 14
			line-color : #8899aa
			line-width : 14:0.3;16:0.6;18:1
			line-style : dotted
		draw : line

	// Railways
	target : rail main
		define
			min-zoom : 6
			line-color : #440000
			line-width : 6:0.5;8:0.8;10:1.2;12:1.6;14:2.2;16:3
			line-style : solid
		draw : line
		define
			text : name
			text-color : #440000
			font-size : 10:8;12:9;14:10;16:11
			text-halo-width : 0
			min-zoom : 11
		draw : text

	target : rail branch
		define
			min-zoom : 8
			line-color : #660000
			line-width : 8:0.4;10:0.7;12:1;14:1.4;16:2
