			min-zoom : 10
			line-color : #f5f5f5
			line-width : 9:0.25;11:0.5;13:0.8;15:1.1;17:1.5
			line-style : solid
		draw : line

	target : hw living street
		define
			min-zoom : 12
			line-color : #f5f5f5
			line-width : 11:0.4;13:0.7;15:1;17:1.4
