		draw : line

	target : route cycling int
		define
			min-zoom : 10
			line-color : #0099ff
			line-width : 10:0.6;12:1;14:1.5;16:2.2;18:3
			line-style : dashed
			line-offset : 0.8
		draw : line

	target : route cycling natl
		define
			min-zoom : 11
			line-color : #0066cc
			line-width : 11:0.5;13:0.9;15:1.3;17:1.9;19:2.6
			line-style : dashed
			line-offset : 0.8
		draw : line

	target : route cycling reg
		define
			min-zoom : 12
			line-color : #3399ff
			line-width : 12:0.4;14:0.8;16:1.2;18:1.8
			line-style : dashed
			line-offset : 0.6
		draw : line

	target : route mtb
		define
			min-zoom : 11
			line-color : #ff9900
			line-width : 11:0.5;13:0.9;15:1.3;17:1.9;19:2.6
			line-style : dashed
			line-offset : 0.8
		draw : line

	// Infrastructure
	target : power line
		define
			min-zoom : 12
			line-color : #ffaa00
			line-width : 13:0.3;15:0.6;17:1;19:1.5
			line-style : dotted
		draw : line

	target : barrier wall
		define
			min-zoom : 14
			line-color : #999999
			line-width : 14:0.3;16:0.6;18:1
			line-style : solid
		draw : line

	// ========== POINT FEATURES ==========
	
	target : place country
		define
			min-zoom : 2
