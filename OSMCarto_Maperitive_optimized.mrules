	// Waymarked routes - overlay style
	target : route hiking int
		define
			min-zoom : 9
			line-color : #ff00ff
			line-width : 9:0.8;11:1.3;13:1.8;15:2.4;17:3.2
			line-style : dashed
			line-offset : 0.8
		draw : line

	target : route hiking natl
		define
			min-zoom : 10
			line-color : #ff3399
			line-width : 10:0.6;12:1;14:1.5;16:2.2;18:3
